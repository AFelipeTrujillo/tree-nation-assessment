{
  "name": "assessment/x-visits-one-tree",
  "description": "X Visits = 1 Tree technical assessment using SlimPHP, PDO, SQLite and lightweight hexagonal architecture.",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "php-di/php-di": "^7.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8080 -t public",
    "migrate": "php bin/migrate.php",
    "test": "phpunit"
  }
}
